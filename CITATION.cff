    title: Exploration of ligand (un)binding trajectories with Rosetta
    authors:
      - family-names: Zlobin
        given-names: Alexander
      - family-names: Eisenhuth
        given-names: Paul
      - family-names: Ferrario
        given-names: Valerio
      - family-names: Meiler
        given-names: Jens
    year: 2026
    journal: bioRxiv
    doi: 10.64898/2026.10.07.757317
  - type: software
    title: LigandPathFinder
    repository-code: "https://github.com/meilerlab/LigandPathFinder"
    license: MIT
